# ===========================================
# CaixaCombo - Configuracao de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Ambiente
NODE_ENV=development
PORT=3001

# Banco de Dados (Supabase PostgreSQL)
# Pegue a URL em: Supabase > Settings > Database > Connection string > URI
DATABASE_URL=

# JWT (OBRIGATORIO - gere com: openssl rand -hex 64)
JWT_SECRET=

# Spring Boot Payment Service
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Stone API (obrigatorio para pagamentos)
STONE_API_URL=https://api.stone.com.br
STONE_API_KEY=
STONE_MERCHANT_ID=
STONE_ENVIRONMENT=PRODUCTION

# CORS (origens permitidas, separadas por virgula - NUNCA usar *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:5173

# Admin (SENHA FORTE OBRIGATORIA - trocar em producao)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Node.js API Secret (comunicacao entre servicos - gere com: openssl rand -hex 32)
NODEJS_API_SECRET=
