{
  "buildCommand": "cd caixa-dashboard/frontend && npm install && npm run build",
  "outputDirectory": "caixa-dashboard/frontend/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://caixa-combo-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://caixa-combo-api.onrender.com/uploads/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://caixa-combo-api.onrender.com/socket.io/:path*" }
  ]
}
