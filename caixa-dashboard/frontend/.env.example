# URL da API do backend (deixe vazio para desenvolvimento local com proxy)
VITE_API_URL=

# Configurações do Pusher Channels (para WebSockets na Vercel)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=

# Configurações do backend (serverless functions)
JWT_SECRET=caixacombo-secret-key
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=

# Configurações do Upstash Redis (banco de dados)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configurações do Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
