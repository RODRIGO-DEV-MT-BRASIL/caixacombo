PORT=3001
FRONTEND_URL=http://localhost:5173

# Configurações do backend
# JWT_SECRET: Gere uma chave aleatória de pelo menos 64 caracteres
# Exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas (obrigatório para persistência em produção)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/caixacombo

# Origens permitidas para CORS (separadas por vírgula)
# OBRIGATÓRIO: Configure apenas as origens permitidas
CORS_ORIGINS=https://seu-dominio.com

# Credenciais do admin padrão (criado na primeira inicialização)
# OBRIGATÓRIO: Configure credenciais seguras
ADMIN_USERNAME=
ADMIN_PASSWORD=
