{
  "name": "caixa-dashboard-server",
  "version": "1.1.0",
  "description": "WebSocket Server para Dashboard CaixaCombo - Com autenticação JWT e persistência",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore '*.json' server.js",
    "dev:all": "concurrently \"npm run dev\" \"cd frontend && npm run dev\" --names \"SERVER,FRONTEND\" --prefix-colors \"blue,green\""
  },
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.42.0",
    "pusher": "^5.3.3",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1"
  }
}
